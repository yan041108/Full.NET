[Unit]
Description=Check Full.NET object storage growth headroom
After=fullnet-object-storage.service

[Service]
Type=oneshot
User=fullnet-storage
StateDirectory=fullnet-object-capacity
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 -B /usr/local/lib/fullnet/Verify-ObjectStorageCapacity.py --metrics-directory=/var/lib/fullnet-object-capacity
TimeoutStartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
