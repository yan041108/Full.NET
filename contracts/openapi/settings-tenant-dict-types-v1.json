    },
    "CreateDictItemRequest": {
      "properties": [
        "label",
        "value",
        "color",
        "displayOrder"
      ]
    },
    "UpdateDictItemRequest": {
      "properties": [
        "label",
        "color",
        "displayOrder",
        "version"
      ]
    },
    "DictItemResponsePage": {
      "properties": [
        "items",
        "page",
