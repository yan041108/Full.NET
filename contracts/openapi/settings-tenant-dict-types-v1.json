{
  "id": "settings-tenant-dict-types-v1",
  "version": 1,
  "description": "租户数据字典类型与字典项 HTTP 契约冻结夹具；与 Settings 模块 Contracts 和 Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/settings/tenant-dict-types",
      "operations": [
        {
          "method": "GET",
          "permission": "settings.tenant_dict_types.read",
          "successStatus": 200,
          "responseSchema": "DictTypeResponsePage"
        },
        {
          "method": "POST",
          "permission": "settings.tenant_dict_types.create",
          "successStatus": 201,
          "requestSchema": "CreateDictTypeRequest",
          "responseSchema": "DictTypeResponse"
        }
      ]
    },
    {
