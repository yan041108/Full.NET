{
  "id": "jobs-host-definitions-v1",
  "version": 1,
  "description": "Host 任务定义与执行 HTTP 契约冻结夹具；与 Jobs 模块 Contracts 和 Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/jobs/host-definitions",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.definitions.read",
          "successStatus": 200,
          "responseSchema": "HostJobDefinitionResponsePage"
        },
        {
          "method": "POST",
          "permission": "jobs.definitions.create",
          "successStatus": 201,
          "requestSchema": "CreateHostJobDefinitionRequest",
          "responseSchema": "HostJobDefinitionResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-definitions/{definitionId}",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.definitions.read",
          "successStatus": 200,
          "responseSchema": "HostJobDefinitionResponse"
        },
        {
          "method": "PUT",
          "permission": "jobs.definitions.update",
          "successStatus": 200,
          "requestSchema": "UpdateHostJobDefinitionRequest",
          "responseSchema": "HostJobDefinitionResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-definitions/{definitionId}/disable",
      "operations": [
        {
          "method": "POST",
          "permission": "jobs.definitions.disable",
          "successStatus": 200,
          "requestSchema": "DisableHostJobDefinitionRequest",
          "responseSchema": "HostJobDefinitionResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-definitions/{definitionId}/trigger",
      "operations": [
        {
          "method": "POST",
          "permission": "jobs.definitions.trigger",
          "successStatus": 201,
          "responseSchema": "HostJobExecutionResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-executions",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.executions.read",
          "successStatus": 200,
          "responseSchema": "HostJobExecutionResponsePage"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-executions/{executionId}",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.executions.read",
          "successStatus": 200,
          "responseSchema": "HostJobExecutionResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.schedules.read",
          "successStatus": 200,
          "responseSchema": "HostJobScheduleResponsePage"
        },
        {
          "method": "POST",
          "permission": "jobs.schedules.create",
          "successStatus": 201,
          "requestSchema": "CreateHostJobScheduleRequest",
          "responseSchema": "HostJobScheduleResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules/definition-options",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.schedules.create",
          "successStatus": 200,
          "responseSchema": "HostJobScheduleDefinitionOptionResponseList"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-health",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.health.read",
          "successStatus": 200,
          "responseSchema": "HostJobHealthResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules/cron-preview",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.schedules.create",
          "successStatus": 200,
          "responseSchema": "HostJobScheduleCronPreviewResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules/{scheduleId}",
      "operations": [
        {
          "method": "GET",
          "permission": "jobs.schedules.read",
          "successStatus": 200,
          "responseSchema": "HostJobScheduleResponse"
        },
        {
          "method": "PUT",
          "permission": "jobs.schedules.update",
          "successStatus": 200,
          "requestSchema": "UpdateHostJobScheduleRequest",
          "responseSchema": "HostJobScheduleResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules/{scheduleId}/pause",
      "operations": [
        {
          "method": "POST",
          "permission": "jobs.schedules.pause",
          "successStatus": 200,
          "requestSchema": "ChangeHostJobScheduleStateRequest",
          "responseSchema": "HostJobScheduleResponse"
        }
      ]
    },
    {
      "path": "/api/v1/jobs/host-schedules/{scheduleId}/resume",
      "operations": [
        {
          "method": "POST",
          "permission": "jobs.schedules.resume",
          "successStatus": 200,
          "requestSchema": "ChangeHostJobScheduleStateRequest",
          "responseSchema": "HostJobScheduleResponse"
        }
      ]
    }
  ],
  "schemas": {
    "HostJobDefinitionResponse": {
      "properties": [
        "id",
        "jobKey",
        "displayName",
        "description",
        "groupName",
        "isEnabled",
        "allowConcurrentExecutions",
        "createdAtUtc",
        "updatedAtUtc",
        "version"
      ]
    },
    "HostJobDefinitionResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "CreateHostJobDefinitionRequest": {
      "properties": [
        "jobKey",
        "displayName",
        "description",
        "groupName",
        "allowConcurrentExecutions"
      ]
    },
    "UpdateHostJobDefinitionRequest": {
      "properties": [
        "displayName",
        "description",
        "groupName",
        "allowConcurrentExecutions",
        "version"
      ]
    },
    "DisableHostJobDefinitionRequest": {
      "properties": [
        "version"
      ]
    },
    "HostJobExecutionResponse": {
      "properties": [
        "id",
        "jobDefinitionId",
        "jobScheduleId",
        "status",
        "triggerKind",
        "scheduledForUtc",
        "errorMessage",
        "startedAtUtc",
        "finishedAtUtc",
        "nextAttemptAtUtc",
        "attemptCount",
        "createdAtUtc"
      ]
    },
    "HostJobExecutionResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "HostJobScheduleResponse": {
      "properties": [
        "id",
        "jobDefinitionId",
        "jobDefinitionJobKey",
        "jobDefinitionDisplayName",
        "triggerKind",
        "cronExpression",
        "timeZoneId",
        "oneTimeAtUtc",
        "misfirePolicy",
        "isEnabled",
        "nextExecutionAtUtc",
        "lastExecutionAtUtc",
        "completedAtUtc",
        "createdAtUtc",
        "updatedAtUtc",
        "version"
      ]
    },
    "HostJobScheduleResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "CreateHostJobScheduleRequest": {
      "properties": [
        "jobDefinitionId",
        "triggerKind",
        "cronExpression",
        "timeZoneId",
        "oneTimeAtUtc",
        "misfirePolicy"
      ]
    },
    "UpdateHostJobScheduleRequest": {
      "properties": [
        "triggerKind",
        "cronExpression",
        "timeZoneId",
        "oneTimeAtUtc",
        "misfirePolicy",
        "version"
      ]
    },
    "ChangeHostJobScheduleStateRequest": {
      "properties": [
        "version"
      ]
    },
    "HostJobScheduleDefinitionOptionResponse": {
      "properties": [
        "id",
        "jobKey",
        "displayName"
      ]
    },
    "HostJobScheduleDefinitionOptionResponseList": {
      "properties": []
    },
    "HostJobScheduleCronPreviewResponse": {
      "properties": [
        "humanDescription",
        "nextExecutionAtUtc",
        "nextOccurrencesUtc"
      ]
    },
    "HostJobHealthResponse": {
      "properties": [
        "registeredHandlers",
        "backlog",
        "workers"
      ]
    }
  }
}
