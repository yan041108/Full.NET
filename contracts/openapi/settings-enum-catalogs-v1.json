{
  "id": "settings-enum-catalogs-v1",
  "version": 1,
  "description": "Host 枚举/常量元数据目录 HTTP 契约冻结夹具。",
  "paths": [
    {
      "path": "/api/v1/settings/enum-catalogs",
      "operations": [
        {
          "method": "GET",
          "permission": "settings.enums.read",
          "successStatus": 200,
          "responseSchema": "EnumCatalogSummary"
        }
      ]
    },
    {
      "path": "/api/v1/settings/enum-catalogs/{catalogKey}",
      "operations": [
        {
          "method": "GET",
          "permission": "settings.enums.read",
          "successStatus": 200,
          "responseSchema": "EnumCatalogDetail"
        }
      ]
    },
    {
      "path": "/api/v1/settings/enum-catalogs/{catalogKey}/dict-generation-preview",
      "operations": [
        {
          "method": "GET",
          "permission": "settings.enums.generate_dict",
          "successStatus": 200,
          "responseSchema": "EnumCatalogDictGenerationPreview"
        }
      ]
    },
    {
      "path": "/api/v1/settings/enum-catalogs/{catalogKey}/dict-generation",
      "operations": [
        {
          "method": "POST",
          "permission": "settings.enums.generate_dict",
          "successStatus": 200,
          "responseSchema": "EnumCatalogDictGenerationResult"
        }
      ]
    }
  ],
  "schemas": {
    "EnumCatalogSummary": {
      "properties": [
        "key",
        "displayName",
        "description",
        "memberCount"
      ]
    },
    "EnumCatalogDetail": {
      "properties": [
        "key",
        "displayName",
        "description",
        "members"
      ]
    },
    "EnumCatalogMember": {
      "properties": [
        "code",
        "label",
        "displayOrder"
      ]
    },
    "EnumCatalogDictGenerationPreview": {
      "properties": [
        "catalogKey",
        "dictTypeCode",
        "dictTypeName",
        "dictTypeExists",
        "willCreateDictType",
        "items",
        "unmanagedItems"
      ]
    },
    "EnumCatalogDictGenerationItemPreview": {
      "properties": [
        "value",
        "proposedLabel",
        "existingLabel",
        "displayOrder",
        "action"
      ]
    },
    "EnumCatalogDictGenerationUnmanagedItem": {
      "properties": [
        "value",
        "label",
        "isActive"
      ]
    },
    "EnumCatalogDictGenerationResult": {
      "properties": [
        "catalogKey",
        "dictTypeCode",
        "dictTypeId",
        "dictTypeCreated",
        "itemsCreated",
        "itemsSkipped",
        "itemsConflicted",
        "itemsInvalid",
        "items"
      ]
    }
  }
}
