{
  "id": "tenancy-host-tenants-v1",
  "version": 1,
  "description": "Host 租户管理 HTTP 契约冻结夹具；与 TenancyTenantManagementContracts 和 ManageHostTenants.Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/tenancy/tenants",
      "operations": [
        {
          "method": "GET",
          "permission": "tenancy.host_tenants.read",
          "successStatus": 200,
          "responseSchema": "TenantSummaryPage"
        },
        {
          "method": "POST",
          "permission": "tenancy.tenants.create",
          "successStatus": 201,
          "requestSchema": "ProvisionTenantRequest",
          "responseSchema": "TenantSummary"
        }
      ]
    },
    {
      "path": "/api/v1/tenancy/tenants/{tenantId}",
      "operations": [
        {
          "method": "GET",
          "permission": "tenancy.host_tenants.read",
          "successStatus": 200,
          "responseSchema": "TenantSummary"
        },
        {
          "method": "PUT",
          "permission": "tenancy.tenants.update",
          "successStatus": 200,
          "requestSchema": "UpdateHostTenantRequest",
          "responseSchema": "TenantSummary"
        }
      ]
    },
    {
      "path": "/api/v1/tenancy/tenants/{tenantId}/disable",
      "operations": [
        {
          "method": "POST",
          "permission": "tenancy.tenants.disable",
          "successStatus": 200,
          "responseSchema": "TenantSummary"
        }
      ]
    },
    {
      "path": "/api/v1/tenancy/tenants/{tenantId}/package",
      "operations": [
        {
          "method": "POST",
          "permission": "tenancy.tenants.assign_package",
          "successStatus": 200,
          "requestSchema": "AssignHostTenantPackageRequest",
          "responseSchema": "TenantSummary"
        }
      ]
    }
  ],
  "schemas": {
    "TenantSummary": {
      "properties": [
        "id",
        "identifier",
        "name",
        "domain",
        "isActive",
        "version",
        "defaultLocale",
        "tenantPackageId",
        "tenantPackageCode",
        "tenantPackageName"
      ]
    },
    "ProvisionTenantRequest": {
      "properties": [
        "identifier",
        "name",
        "domain",
        "tenantPackageId"
      ]
    },
    "UpdateHostTenantRequest": {
      "properties": [
        "name",
        "version"
      ]
    },
    "AssignHostTenantPackageRequest": {
      "properties": [
        "tenantPackageId",
        "version"
      ]
    },
    "TenantSummaryPage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ],
      "itemSchema": "TenantSummary"
    }
  }
}
