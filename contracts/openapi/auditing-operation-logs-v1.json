{
  "id": "auditing-operation-logs-v1",
  "version": 1,
  "description": "Host 操作日志查询 HTTP 契约冻结夹具。",
  "paths": [
    {
      "path": "/api/v1/auditing/operation-logs",
      "operations": [
        {
          "method": "GET",
          "permission": "auditing.operations.read",
          "successStatus": 200,
          "responseSchema": "OperationLogResponse",
          "queryParameters": [
            "fromUtc",
            "toUtc",
            "pathContains"
          ],
          "errorStatuses": [
            400
          ]
        }
      ]
    },
    {
      "path": "/api/v1/auditing/operation-logs/{operationLogId}",
      "operations": [
        {
          "method": "GET",
          "permission": "auditing.operations.read",
          "successStatus": 200,
          "responseSchema": "OperationLogResponse"
        }
      ]
    },
    {
      "path": "/api/v1/auditing/operation-logs/{operationLogId}/details",
      "operations": [
        {
          "method": "GET",
          "permission": "auditing.operations.details.read",
          "additionalPermissions": [
            "auditing.operations.read"
          ],
          "successStatus": 200,
          "responseSchema": "OperationLogDetailsResponse",
          "errorStatuses": [
            401,
            403,
            404
          ]
        }
      ]
    }
  ],
  "schemas": {
    "OperationLogResponse": {
      "properties": [
        "id",
        "occurredAtUtc",
        "actionKey",
        "httpMethod",
        "requestPath",
        "statusCode",
        "durationMs",
        "succeeded",
        "userId",
        "tenantId",
        "traceId",
        "clientIpFingerprint",
        "permissionCode"
      ]
    },
    "OperationLogDetailsResponse": {
      "properties": [
        "id",
        "detailsExpiresAtUtc",
        "context"
      ]
    },
    "OperationLogDetailsContextV1": {
      "properties": [
        "schemaVersion",
        "clientIp",
        "clientPort",
        "serverIp",
        "serverPort",
        "requestCaptureState",
        "requestSummary",
        "responseCaptureState",
        "responseSummary"
      ]
    },
    "OperationLogExportRequestSummaryV1": {
      "properties": [
        "fromUtc",
        "toUtc",
        "statusCode",
        "succeeded"
      ]
    },
    "OperationLogExportResponseSummaryV1": {
      "properties": [
        "rowCount",
        "truncated",
        "includesSensitiveFields"
      ]
    }
  }
}
