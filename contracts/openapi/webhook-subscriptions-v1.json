  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "WebhookSubscriptionResponse": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "eventType",
          "targetUrl",
          "isActive",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[\\x21-\\x7E]{1,128}$"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "isActive": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "CreateWebhookSubscriptionRequest": {
        "type": "object",
        "required": [
          "eventType",
          "targetUrl",
          "signingSecret"
        ],
        "properties": {
          "eventType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\x21-\\x7E]{1,128}$"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "signingSecret": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "writeOnly": true
          }
        }
      },
      "SetWebhookSubscriptionStatusRequest": {
        "type": "object",
        "required": [
          "isActive",
          "version"
        ],
        "properties": {
          "isActive": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "WebhookDeliveryHistoryResponse": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "subscriptionId",
          "eventId",
          "statusKey",
          "attemptCount",
          "nextAttemptAtUtc",
          "lastErrorCode",
          "lastHttpStatus",
          "createdAtUtc",
          "updatedAtUtc",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "subscriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "statusKey": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "delivered",
              "failed"
            ]
          },
          "attemptCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "nextAttemptAtUtc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastErrorCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "webhooks.delivery.http_error",
              "webhooks.delivery.timeout",
              "webhooks.delivery.failed"
            ]
          },
          "lastHttpStatus": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        }
      },
      "WebhookDeliveryHistoryPageResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/WebhookDeliveryHistoryResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+$"
              }
            ]
          }
        }
      },
      "WebhookDeliveryAttemptResponse": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "subscriptionId",
          "deliveryId",
          "outcomeKey",
          "startedAtUtc",
          "completedAtUtc",
          "httpStatus",
          "errorCode",
          "appliedToDelivery"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "subscriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "outcomeKey": {
            "type": "string",
            "enum": [
              "processing",
              "unconfirmed",
              "delivered",
              "failed"
            ]
          },
          "startedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "webhooks.delivery.http_error",
              "webhooks.delivery.timeout",
              "webhooks.delivery.target_invalid",
              "webhooks.delivery.target_blocked",
              "webhooks.delivery.transport_error",
              "webhooks.delivery.failed"
            ]
          },
          "appliedToDelivery": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "WebhookDeliveryAttemptPageResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/WebhookDeliveryAttemptResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+$"
              }
            ]
          }
        }
      }
    }
  }
}
