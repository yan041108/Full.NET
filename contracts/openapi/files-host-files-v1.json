{
  "id": "files-host-files-v1",
  "version": 2,
  "description": "Host 文件元数据 HTTP 契约冻结夹具；与 Files 模块 Contracts 和 Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/files/host-files",
      "operations": [
        {
          "method": "GET",
          "permission": "files.files.read",
          "successStatus": 200,
          "responseSchema": "HostFileResponsePage"
        },
        {
          "method": "POST",
          "permission": "files.files.upload",
          "successStatus": 201,
          "responseSchema": "HostFileResponse"
        }
      ]
    },
    {
      "path": "/api/v1/files/host-files/{fileId}",
      "operations": [
        {
          "method": "GET",
          "permission": "files.files.read",
          "successStatus": 200,
          "responseSchema": "HostFileResponse"
        }
      ]
    },
    {
      "path": "/api/v1/files/host-files/{fileId}/update",
      "operations": [
        {
          "method": "POST",
          "permission": "files.files.update",
          "successStatus": 200,
          "requestSchema": "UpdateHostFileMetadataRequest",
          "responseSchema": "HostFileResponse"
        }
      ]
    },
    {
      "path": "/api/v1/files/host-files/{fileId}/references",
      "operations": [
        {
          "method": "GET",
          "permission": "files.file_references.read",
          "successStatus": 200,
          "responseSchema": "HostFileReferenceClaimResponsePage"
        }
      ]
    },
    {
      "path": "/api/v1/files/host-files/{fileId}/content",
      "operations": [
        {
          "method": "GET",
          "permission": "files.files.download",
          "successStatus": 200
        }
      ]
    },
    {
      "path": "/api/v1/files/host-files/{fileId}/delete",
      "operations": [
        {
          "method": "POST",
          "permission": "files.files.delete",
          "successStatus": 200,
          "responseSchema": "HostFileResponse"
        }
      ]
    }
  ],
  "schemas": {
    "HostFileResponse": {
      "properties": [
        "id",
        "originalFileName",
        "contentType",
        "sizeBytes",
        "contentHash",
        "createdAtUtc",
        "createdByUserId",
        "folderId",
        "revision",
        "updatedAtUtc",
        "updatedByUserId"
      ]
    },
    "HostFileResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "UpdateHostFileMetadataRequest": {
      "properties": [
        "expectedRevision",
        "originalFileName",
        "folderId"
      ]
    },
    "HostFileReferenceClaimResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "HostFileReferenceClaimResponse": {
      "properties": [
        "id",
        "idempotencyKey",
        "consumerModule",
        "consumerReferenceId",
        "state",
        "createdAtUtc",
        "updatedAtUtc",
        "confirmedAtUtc",
        "releasedAtUtc"
      ]
    }
  }
}
