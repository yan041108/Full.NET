{
  "id": "observability-elasticsearch-health-v1",
  "version": 1,
  "description": "日志入口与 Elasticsearch 查询配置 HTTP 契约，不表示远端投递确认。",
  "paths": [
    {
      "path": "/api/v1/observability/elasticsearch-log-pipeline/health",
      "operations": [
        { "method": "GET", "permission": "observability.elasticsearch.read", "successStatus": 200, "responseSchema": "ElasticsearchLogPipelineHealthResponse" }
      ]
    }
  ],
  "schemas": {
    "ElasticsearchLogPipelineHealthResponse": {
      "properties": [
        "deliveryStatus", "deliveryConfirmationBoundary", "elasticsearchQueryEnabled",
        "elasticsearchEndpoint", "elasticsearchIndexPattern", "openTelemetryOtlpEndpointConfigured"
      ]
    }
  }
}
