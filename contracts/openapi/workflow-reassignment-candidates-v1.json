{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Workflow administrative reassignment candidates"
  },
  "paths": {
    "/api/v1/workflow/instances/{instanceId}/reassignment-candidates": {
      "get": {
        "operationId": "workflowListReassignmentCandidates",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "instanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "todoId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current active candidates within the trusted scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowReassignmentCandidatePageResponse"
                }
              }
            }
          },
          "400": {
            "description": "ProblemDetails"
          },
          "401": {
            "description": "ProblemDetails"
          },
          "403": {
            "description": "ProblemDetails"
          },
          "404": {
            "description": "ProblemDetails"
          },
          "409": {
            "description": "ProblemDetails"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "WorkflowRecipientCandidateResponse": {
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "displayName"
        ],
        "type": "object"
      },
      "WorkflowRecipientCandidatePageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkflowRecipientCandidateResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "pageSize": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "total": {
            "format": "int64",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object"
      },
      "WorkflowReassignmentCandidatePageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkflowRecipientCandidateResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "pageSize": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "total": {
            "format": "int64",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "instanceId": {
            "type": "string",
            "format": "uuid"
          },
          "instanceRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "todoId": {
            "type": "string",
            "format": "uuid"
          },
          "todoRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total",
          "instanceId",
          "instanceRevision",
          "todoId",
          "todoRevision"
        ],
        "type": "object"
      }
    }
  }
}
