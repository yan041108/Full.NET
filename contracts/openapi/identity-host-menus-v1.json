{
  "id": "identity-host-menus-v1",
  "version": 1,
  "description": "Host 菜单管理 HTTP 契约冻结夹具；与 IdentityMenuManagementContracts 和 ManageHostMenus.Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/identity/menus",
      "operations": [
        {
          "method": "GET",
          "permission": "identity.menus.read",
          "successStatus": 200,
          "responseSchema": "HostMenuResponsePage"
        },
        {
          "method": "POST",
          "permission": "identity.menus.create",
          "successStatus": 201,
          "requestSchema": "CreateHostMenuRequest",
          "responseSchema": "HostMenuResponse"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/all",
      "operations": [
        {
          "method": "GET",
          "permission": "identity.menus.read",
          "successStatus": 200,
          "responseSchema": "HostMenuResponseArray"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/{menuId}",
      "operations": [
        {
          "method": "GET",
          "permission": "identity.menus.read",
          "successStatus": 200,
          "responseSchema": "HostMenuResponse"
        },
        {
          "method": "PUT",
          "permission": "identity.menus.update",
          "successStatus": 200,
          "requestSchema": "UpdateHostMenuRequest",
          "responseSchema": "HostMenuResponse"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/permission-options",
      "operations": [
        {
          "method": "GET",
          "permission": "identity.menus.read",
          "successStatus": 200,
          "responseSchema": "HostMenuPermissionOptionResponseArray"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/sync-catalog",
      "operations": [
        {
          "method": "POST",
          "permission": "identity.menus.update",
          "successStatus": 200,
          "responseSchema": "HostNavigationCatalogSyncResponse"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/{menuId}/disable",
      "operations": [
        {
          "method": "POST",
          "permission": "identity.menus.disable",
          "successStatus": 200,
          "responseSchema": "HostMenuResponse"
        }
      ]
    },
    {
      "path": "/api/v1/identity/menus/{menuId}/enable",
      "operations": [
        {
          "method": "POST",
          "permission": "identity.menus.update",
          "successStatus": 200,
          "responseSchema": "HostMenuResponse"
        }
      ]
    }
  ],
  "schemas": {
    "HostMenuResponse": {
      "properties": [
        "id",
        "parentId",
        "routeName",
        "path",
        "componentKey",
        "title",
        "caption",
        "icon",
        "displayOrder",
        "requiredPermission",
        "isSystem",
        "isActive",
        "createdAtUtc",
        "updatedAtUtc",
        "version",
        "menuType",
        "redirect",
        "linkUrl",
        "isHidden",
        "isKeepAlive",
        "isAffix",
        "isEmbedded",
        "remark"
      ]
    },
    "CreateHostMenuRequest": {
      "properties": [
        "parentId",
        "routeName",
        "path",
        "componentKey",
        "title",
        "caption",
        "icon",
        "displayOrder",
        "requiredPermission",
        "menuType",
        "redirect",
        "linkUrl",
        "isHidden",
        "isKeepAlive",
        "isAffix",
        "isEmbedded",
        "remark"
      ]
    },
    "UpdateHostMenuRequest": {
      "properties": [
        "parentId",
        "path",
        "componentKey",
        "title",
        "caption",
        "icon",
        "displayOrder",
        "requiredPermission",
        "version",
        "menuType",
        "redirect",
        "linkUrl",
        "isHidden",
        "isKeepAlive",
        "isAffix",
        "isEmbedded",
        "remark"
      ]
    },
    "HostMenuResponsePage": {
      "properties": [
        "items",
        "page",
        "pageSize",
        "total"
      ]
    },
    "HostMenuResponseArray": {
      "properties": [
        "id",
        "parentId",
        "routeName",
        "path",
        "componentKey",
        "title",
        "caption",
        "icon",
        "displayOrder",
        "requiredPermission",
        "isSystem",
        "isActive",
        "createdAtUtc",
        "updatedAtUtc",
        "version",
        "menuType",
        "redirect",
        "linkUrl",
        "isHidden",
        "isKeepAlive",
        "isAffix",
        "isEmbedded",
        "remark"
      ]
    },
    "HostMenuPermissionOptionResponseArray": {
      "properties": [
        "code",
        "moduleKey",
        "moduleTitle",
        "pageId",
        "pageTitle",
        "kind",
        "displayName",
        "displayNameKey",
        "actionId",
        "actionKey"
      ]
    },
    "HostNavigationCatalogSyncResponse": {
      "properties": [
        "created",
        "skipped",
        "reparented"
      ]
    }
  }
}
