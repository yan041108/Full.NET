{
  "schemaVersion": 1,
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "identityGetCurrentUser",
        "responses": {
          "200": {
            "description": "Current authenticated user profile",
            "responseSchema": "CurrentUserResponse"
          },
          "401": {
            "description": "Current session is no longer active"
          }
        }
      }
    },
    "/api/v1/me/password": {
      "post": {
        "operationId": "identityChangePassword",
        "responses": {
          "200": {
            "description": "Rotated session tokens after a successful password change",
            "responseSchema": "TokenResponse"
          },
          "401": {
            "description": "Current session is no longer active"
          }
        }
      }
    }
  },
  "schemas": {
    "CurrentUserResponse": {
      "properties": [
        "id",
        "username",
        "displayName",
        "tenantId",
        "actorScope",
        "scope",
        "isSuperAdministrator",
        "permissions",
        "sessionId",
        "preferredLocale",
        "profileVersion"
      ]
    }
  }
}
