{
  "id": "document-host-permissions-v1",
  "version": 1,
  "description": "Host 文档权限 HTTP 契约冻结夹具；与 HostDocumentContracts 和 ManageHostDocumentPermissions.Endpoint 对齐。",
  "paths": [
    {
      "path": "/api/v1/document/host/permissions/by-document/{documentId}",
      "operations": [
        {
          "method": "GET",
          "permission": "document.host_permissions.read",
          "successStatus": 200,
          "responseSchema": "HostDocumentPermissionResponseList"
        }
      ]
    },
    {
      "path": "/api/v1/document/host/permissions",
      "operations": [
        {
          "method": "POST",
          "permission": "document.host_permissions.set",
          "successStatus": 200,
          "requestSchema": "SetHostDocumentPermissionsRequest",
          "responseSchema": "HostDocumentPermissionResponseList"
        }
      ]
    },
    {
      "path": "/api/v1/document/host/permissions/context/{documentId}",
      "operations": [
        {
          "method": "GET",
          "permission": "document.host_permissions.read",
          "successStatus": 200,
          "responseSchema": "HostDocumentPermissionContext"
        }
      ]
    },
    {
      "path": "/api/v1/document/host/permissions/snapshot/{documentId}",
      "operations": [
        {
          "method": "GET",
          "permission": "document.host_permissions.read",
          "successStatus": 200,
          "responseSchema": "HostDocumentPermissionSnapshotResponse"
        }
      ]
    }
  ],
  "schemas": {
    "HostDocumentPermissionEntry": {
      "properties": [
        "userId",
        "actions"
      ]
    },
    "SetHostDocumentPermissionsRequest": {
      "properties": [
        "documentId",
        "permissions",
        "visibilityMode",
        "version"
      ]
    },
    "HostDocumentPermissionResponse": {
      "properties": [
        "id",
        "documentId",
        "userId",
        "actions",
        "createdAtUtc"
      ]
    },
    "HostDocumentPermissionResponseList": {
      "properties": [],
      "itemSchema": "HostDocumentPermissionResponse"
    },
    "HostDocumentPermissionContext": {
      "properties": [
        "documentId",
        "title",
        "documentNo",
        "visibilityMode",
        "version"
      ]
    },
    "HostDocumentPermissionSnapshotResponse": {
      "properties": [
        "documentId",
        "version",
        "permissions"
      ]
    }
  }
}
