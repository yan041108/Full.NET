{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionName": "fullnet",
    "MySqlGuidStorageMode": "Binary16",
    "CommandTimeoutSeconds": 30
  },
  "Messaging": {
    "KafkaReplay": {
      "Enabled": false,
      "MaximumSynchronousMessages": 1000,
      "ExecutionTimeoutSeconds": 45
    },
    "DeliveryCutover": {
      "Enabled": false
    }
  },
  "Identity": {
    "Issuer": "Full.NET",
    "Audience": "Full.NET.Api",
    "ClientId": "fullnet-admin",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "RequireSecureCookies": true,
    "AllowDevelopmentEphemeralSigningKey": false,
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "EnableGlobalApiLimit": true,
    "GlobalApiPermitLimitPerMinute": 1200
  },
  "Document": {
    "AnonymousShareAccessRateLimitPermitLimitPerMinute": 30
  },
  "TrustedProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Auditing": {
    "Query": {
      "MaximumContainsWindowDays": 1
    },
    "MicroBatch": {
      "Capacity": 4096,
      "MaxBatchRows": 64,
      "MaxBatchBytes": 262144,
      "MaxBatchDelay": "00:00:00.020",
      "EnqueueTimeout": "00:00:00.100",
      "ShutdownFlushTimeout": "00:00:05"
    }
  },
  "Observability": {
    "HttpOperation": {
      "Enabled": true,
      "CaptureMode": "Summary",
      "CapacityProfile": "XL",
      "AlwaysRecordErrors": true,
      "SlowRequestThreshold": "00:00:01",
      "PriorityCapacity": 2048,
      "BestEffortCapacity": 8192,
      "MaxRequestPayloadBytes": 2048,
      "MaxResponsePayloadBytes": 0,
      "IncludePathPrefixes": [ "/api" ],
      "ExcludePathPrefixes": [ "/health", "/openapi", "/scalar" ],
      "PayloadRouteAllowList": []
    }
  },
  "Cache": {
    "RedisConnectionString": ""
  },
  "Realtime": {
    "Enabled": true,
    "HubPath": "/hubs/notifications",
    "RedisBackplaneConnectionString": "",
    "AllowSharedRedisInDevelopment": false,
    "TransportMode": "Default",
    "SkipNegotiation": false,
    "RequireSessionAffinity": true
  },
  "DataProtection": {
    "ApplicationName": "Full.NET",
    "KeyRingPath": "App_Data/data-protection-keys"
  },
  "CodeGeneration": {
    "Apply": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
