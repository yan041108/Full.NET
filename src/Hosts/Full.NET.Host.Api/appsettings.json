{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionName": "fullnet",
    "MySqlGuidStorageMode": "Binary16",
    "CommandTimeoutSeconds": 30
  },
  "Identity": {
    "Issuer": "Full.NET",
    "Audience": "Full.NET.Api",
    "ClientId": "fullnet-admin",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "RequireSecureCookies": true,
    "AllowDevelopmentEphemeralSigningKey": false,
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "EnableGlobalApiLimit": true,
    "GlobalApiPermitLimitPerMinute": 1200
  },
  "TrustedProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Auditing": {
    "Query": {
      "MaximumContainsWindowDays": 1
    },
    "MicroBatch": {
      "Capacity": 4096,
      "MaxBatchRows": 64,
      "MaxBatchBytes": 262144,
      "MaxBatchDelay": "00:00:00.020",
      "EnqueueTimeout": "00:00:00.100",
      "ShutdownFlushTimeout": "00:00:05"
    }
  },
  "CodeGeneration": {
    "Apply": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
