{
  "Identity": {
    "AllowDevelopmentEphemeralSigningKey": true,
    "EnableRemoteSuperAdministratorManagement": true,
    "AllowedOrigins": [
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "Tenancy": {
    "HostDomains": [
      "localhost",
      "127.0.0.1"
    ]
  },
  "Files": {
    "Local": {
      "RootPath": "App_Data/files"
    }
  },
  "Realtime": {
    "Enabled": true,
    "HubPath": "/hubs/notifications",
    "AllowSharedRedisInDevelopment": true,
    "TransportMode": "Default",
    "SkipNegotiation": false,
    "RequireSessionAffinity": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
