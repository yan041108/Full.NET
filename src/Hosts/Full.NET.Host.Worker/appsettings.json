{
  "Database": {
    "Provider": "SqlServer",
    "ConnectionName": "fullnet",
    "MySqlGuidStorageMode": "Binary16",
    "CommandTimeoutSeconds": 30
  },
  "Jobs": {
    "Worker": {
      "BatchSize": 10,
      "MaxConcurrency": 1,
      "PollMilliseconds": 2000,
      "LeaseSeconds": 300,
      "LeaseRenewalSeconds": 60,
      "MaxAttempts": 1,
      "RetryDelaySeconds": 30,
      "RetryBackoffMode": "fixed",
      "RetryMaxDelaySeconds": 86400,
      "RetryJitterPercent": 0,
      "BacklogSampleSeconds": 30
    }
  },
  "Auditing": {
    "Retention": {
      "Enabled": false,
      "AccessRetentionDays": 30,
      "OperationRetentionDays": 365,
      "ExceptionRetentionDays": 90,
      "BatchSize": 200,
      "MaxBatchesPerRun": 15,
      "PollSeconds": 3600
    }
  },
  "OutboxRetention": {
    "Enabled": false,
    "RetentionDays": 30,
    "BatchSize": 200,
    "MaxBatchesPerRun": 15,
    "PollSeconds": 3600
  },
  "Messaging": {
    "Worker": {
      "Mode": "LegacyPolling"
    },
    "DeliveryCutover": {
      "Enabled": false
    },
    "ShadowComparison": {
      "Enabled": false
    },
    "Kafka": {
      "Enabled": false,
      "BootstrapServers": "",
      "SecurityProtocol": "Ssl",
      "ConsumerGroupProtocol": "Classic",
      "BrokerMajorVersion": 3,
      "ClassicPartitionAssignment": "LegacyRange",
      "CooperativeStickyMigrationCompleted": false,
      "ProducerLingerMilliseconds": 5,
      "ProducerBatchSizeBytes": 65536,
      "ProducerQueueMaxMessages": 20000,
      "ProducerQueueMaxKbytes": 65536,
      "ProducerMaxInFlightRequests": 5,
      "ConsumerBufferHighWatermark": 256,
      "ConsumerBufferLowWatermark": 128,
      "PartitionBufferHighWatermark": 1,
      "PartitionBufferLowWatermark": 0,
      "PartitionKeyConcurrencySlots": 1,
      "OffsetCommitMode": "PerMessage",
      "OffsetCommitIntervalMilliseconds": 1000,
      "OffsetCommitBatchSize": 100,
      "PeriodicOffsetCommitVerified": false
    }
  },
  "Cache": {
    "RedisConnectionString": ""
  },
  "Realtime": {
    "Enabled": true,
    "RedisBackplaneConnectionString": "",
    "AllowSharedRedisInDevelopment": false,
    "TransportMode": "Default",
    "SkipNegotiation": false,
    "RequireSessionAffinity": true
  },
  "DataProtection": {
    "ApplicationName": "Full.NET",
    "KeyRingPath": "App_Data/data-protection-keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
