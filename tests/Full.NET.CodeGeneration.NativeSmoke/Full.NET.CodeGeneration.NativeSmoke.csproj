<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <!-- 沿用 ADR-0008 的第三方程序集诊断门禁，发布日志仍须通过现有 allowlist。 -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeHostConfigurationOption Include="Microsoft.Data.SqlClient.EnableReflectionBasedAuthenticationProviderDiscovery" Value="false" Trim="true" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/BuildingBlocks/Full.NET.Data.CodeGeneration/Full.NET.Data.CodeGeneration.csproj" />
    <ProjectReference Include="../../src/BuildingBlocks/Full.NET.Data.Dapper/Full.NET.Data.Dapper.csproj" />
    <ProjectReference Include="../../src/BuildingBlocks/Full.NET.Hosting/Full.NET.Hosting.csproj" />
    <ProjectReference Include="../../src/Modules/Full.NET.Modules.Organization.Contracts/Full.NET.Modules.Organization.Contracts.csproj" />
    <ProjectReference Include="../../src/Modules/Full.NET.Modules.Identity.Contracts/Full.NET.Modules.Identity.Contracts.csproj" />
    <Compile Include="../Shared/CodeGeneration/CodeGenerationRemediationSchemas.cs" Link="Schemas.cs" />
    <Compile Include="../Shared/CodeGeneration/Remediation/*.g.cs" Link="Generated/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
