<Project Sdk="MSTest.Sdk">
  <Target Name="ValidateNativeFocusedHostSelection" BeforeTargets="PrepareForBuild"
          Condition="('$(FullNetWorkflowNativeFocused)' == 'true' and '$(FullNetIndependentHostNativeFocused)' == 'true') or ('$(FullNetCorrectionReadFocused)' == 'true' and ('$(FullNetWorkflowNativeFocused)' == 'true' or '$(FullNetIndependentHostNativeFocused)' == 'true')) or ('$(FullNetCorrectionWorkerNativeFocused)' == 'true' and ('$(FullNetWorkflowNativeFocused)' == 'true' or '$(FullNetIndependentHostNativeFocused)' == 'true' or '$(FullNetCorrectionReadFocused)' == 'true'))">
    <Error Text="控制器聚焦模式只能选择一个，不能混合 Workflow、独立角色与校对读取。" />
  </Target>
  <ItemGroup Condition="'$(FullNetWorkflowNativeFocused)' != 'true' and '$(FullNetIndependentHostNativeFocused)' != 'true' and '$(FullNetCorrectionReadFocused)' != 'true' and '$(FullNetCorrectionWorkerNativeFocused)' != 'true'">
    <ProjectReference Include="../Tools/Full.NET.EnterpriseRequest.WorkerFixture/Full.NET.EnterpriseRequest.WorkerFixture.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../Shared/Testing/ApprovalProgressReadPolling.cs" Link="Testing/ApprovalProgressReadPolling.cs" />
    <Compile Include="../Shared/Testing/NativeMigratorProcess.cs" Link="Testing/NativeMigratorProcess.cs" />
    <Compile Include="../Shared/CodeGeneration/GeneratedMigrationRecoveryFixture.cs" Link="CodeGeneration/GeneratedMigrationRecoveryFixture.cs" />
    <Compile Include="../Shared/CodeGeneration/CodeGenerationRemediationSchemas.cs" Link="CodeGeneration/CodeGenerationRemediationSchemas.cs" />
    <Compile Include="../Shared/CodeGeneration/Remediation/*.g.cs" Link="CodeGeneration/Remediation/%(Filename)%(Extension)" />
  </ItemGroup>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 集成测试直接使用 JIT Dapper；禁止 Dapper.AOT 顾问规则误伤 TreatWarningsAsErrors。 -->
    <NoWarn>$(NoWarn);DAP005;DAP018;DAP200;DAP223;DAP224;DAP230;DAP241;DAP025;DAP037</NoWarn>
  </PropertyGroup>
  <!-- 原生Workflow验收仅编译控制器及其直接夹具；默认集成测试源码集合保持不变。 -->
  <PropertyGroup Condition="'$(FullNetWorkflowNativeFocused)' == 'true' or '$(FullNetIndependentHostNativeFocused)' == 'true' or '$(FullNetCorrectionReadFocused)' == 'true' or '$(FullNetCorrectionWorkerNativeFocused)' == 'true'">
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- 两个新角色只编译直接控制器和共用服务夹具，既有 Workflow 聚焦模式保持独立。 -->
  <ItemGroup Condition="'$(FullNetIndependentHostNativeFocused)' == 'true' or '$(FullNetCorrectionReadFocused)' == 'true' or '$(FullNetCorrectionWorkerNativeFocused)' == 'true'">
    <Compile Include="*.cs" />
    <Compile Include="Api/FullNetApiFactory.cs;Api/IntegrationTestAuthHelper.cs;Api/IntegrationTestTenantContextHelper.cs;Api/IntegrationWorkerHostFactory.cs" />
    <Compile Include="Infrastructure/NativeContainerResourceProfile.cs" />
    <Compile Include="Messaging/KafkaFixture.cs;Messaging/CdcDebeziumPipelineFixture.cs;Messaging/MessagingHttpFaultProxy.cs" />
    <Compile Include="Messaging/CdcDebeziumConnectorTestSupport.cs;Messaging/SqlServerCdcTestSupport.cs" />
    <Compile Include="Migrations/Migration114To126RecoveryTestSupport.cs;Migrations/Migration111WorkflowTodoTimeoutPolicyRecoveryTests.cs;Migrations/NamingExpandTestMigrationRunner.cs;Migrations/MigrationContractOptionFactory.cs" />
    <Compile Include="Messaging/KafkaLogTlsFixture.cs;Messaging/PausedElasticsearchBulkProxy.cs;Messaging/KafkaLogConsumerElasticsearchTlsTests.cs;Messaging/KafkaLogConsumerDeliveryTests.cs"
             Condition="'$(FullNetIndependentHostNativeFocused)' == 'true'" />
    <Compile Include="NativeAot/NativeIndependentHostProcess.cs;NativeAot/NativeMigratorE2ETests.cs;NativeAot/NativeLogConsumerE2ETests.cs"
             Condition="'$(FullNetIndependentHostNativeFocused)' == 'true'" />
    <Compile Include="Ai/AiKnowledgeCorrectionManifestTests.cs;Ai/AiKnowledgeCorrectionVectorTests.cs;Migrations/Migration246AiKnowledgeIndexTaskRecoveryTests.cs;Migrations/ReviewFixMigrationRecoverySupport.cs;Migrations/AiKnowledgeAutomaticIndexSql.cs"
             Condition="'$(FullNetCorrectionReadFocused)' == 'true'" />
    <Compile Include="NativeAot/NativeWorkerCorrectionGenerationE2ETests.cs;NativeAot/NativeApiProcessHost.cs;NativeAot/NativeWorkerProcessHost.cs;NativeAot/NativeApiArtifactLocator.cs;NativeAot/NativeWorkerArtifactLocator.cs;NativeAot/NativeAotTestTimeouts.cs;NativeAot/NativeKnowledgeModelServer.cs;NativeAot/KnowledgeRefinementReply.cs;Migrations/Migration246AiKnowledgeIndexTaskRecoveryTests.cs;Migrations/ReviewFixMigrationRecoverySupport.cs;Migrations/AiKnowledgeAutomaticIndexSql.cs"
             Condition="'$(FullNetCorrectionWorkerNativeFocused)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(FullNetWorkflowNativeFocused)' == 'true'">
    <Compile Include="*.cs" />
    <Compile Include="Api/FullNetApiFactory.cs;Api/IntegrationTestAuthHelper.cs;Api/IntegrationTestTenantContextHelper.cs;Api/IntegrationWorkerHostFactory.cs" />
    <Compile Include="Infrastructure/NativeContainerResourceProfile.cs" />
    <Compile Include="Messaging/KafkaFixture.cs;Messaging/CdcDebeziumPipelineFixture.cs" />
    <Compile Include="Messaging/MessagingHttpFaultProxy.cs;Messaging/MessagingKafkaFaultProxy.cs" />
    <Compile Include="Messaging/CdcDebeziumConnectorTestSupport.cs;Messaging/SqlServerCdcTestSupport.cs" />
    <Compile Include="Migrations/Migration114To126RecoveryTestSupport.cs;Migrations/Migration111WorkflowTodoTimeoutPolicyRecoveryTests.cs;Migrations/NamingExpandTestMigrationRunner.cs;Migrations/MigrationContractOptionFactory.cs" />
    <Compile Include="Workflow/WorkflowCollaborationRequestApiTests*.cs" />
    <Compile Include="Messaging/EventDeliveryCutoverTests.cs;Messaging/EventDeliveryRollbackTests.cs;Messaging/MessagingDeliveryControlTests.cs;Messaging/EventDeliveryPilotTestSupport.cs;Messaging/MessagingOutboxTestSupport.cs"
             Condition="'$(FullNetMessagingCutoverFocused)' == 'true'" />
  </ItemGroup>
  <!-- 容量实验只在显式配置中编译；日常发现不运行长时压力，也不以跳过冒充通过。 -->
  <ItemGroup Condition="'$(FullNetLoggingCapacity)' != 'true'">
    <Compile Remove="Auditing/AuditingSustainedCapacityTests.cs;Messaging/KafkaLogRouteCapacityTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Testing/SessionBindingTestPrincipal.cs" Link="Testing/SessionBindingTestPrincipal.cs" />
    <ProjectReference Include="..\..\benchmarks\Full.NET.Benchmarks\Full.NET.Benchmarks.csproj" Aliases="kafkabenchmarks" />
    <ProjectReference Include="..\..\src\Tools\Full.NET.CodeGeneration.Cli\Full.NET.CodeGeneration.Cli.csproj" Aliases="codegencli" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Data.CodeGeneration\Full.NET.Data.CodeGeneration.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Data.Abstractions\Full.NET.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Data.Dapper\Full.NET.Data.Dapper.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Data.MySql\Full.NET.Data.MySql.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Migrations.DbUp\Full.NET.Migrations.DbUp.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Messaging.Abstractions\Full.NET.Messaging.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Messaging.Kafka\Full.NET.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Logging.Kafka\Full.NET.Logging.Kafka.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Modularity\Full.NET.Modularity.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Seeding.Dapper\Full.NET.Seeding.Dapper.csproj" />
    <ProjectReference Include="..\..\src\BuildingBlocks\Full.NET.Serialization.MemoryPack\Full.NET.Serialization.MemoryPack.csproj" />
    <ProjectReference Include="..\..\src\Hosts\Full.NET.Host.Api\Full.NET.Host.Api.csproj" />
    <!-- 原生数据库前置复用 JIT Migrator；仅保证构建顺序，不引入测试程序集依赖。 -->
    <ProjectReference Include="..\..\src\Hosts\Full.NET.Host.Migrator\Full.NET.Host.Migrator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Hosts\Full.NET.Host.LogConsumer\Full.NET.Host.LogConsumer.csproj" Aliases="consumerhost" />
    <ProjectReference Include="..\..\src\Hosts\Full.NET.Host.Worker\Full.NET.Host.Worker.csproj" Aliases="workerhost" />
    <!-- 原生用例复用此构建复制的 JIT Migrator，禁止逐例隐式编译。 -->
    <ProjectReference Include="..\..\src\Hosts\Full.NET.Host.Migrator\Full.NET.Host.Migrator.csproj" Aliases="migratorhost" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Identity\Full.NET.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Notifications.Contracts\Full.NET.Modules.Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.CodeGeneration\Full.NET.Modules.CodeGeneration.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.ObservabilityAdmin\Full.NET.Modules.ObservabilityAdmin.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Document\Full.NET.Modules.Document.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Jobs\Full.NET.Modules.Jobs.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Messaging\Full.NET.Modules.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.SerialNumbers\Full.NET.Modules.SerialNumbers.csproj" />
    <!-- WebApplicationFactory 需要把 Composition 的官方模块闭包显式写入测试 deps.json。 -->
    <ProjectReference Include="..\..\src\Modules\Full.NET.Modules.Workflow\Full.NET.Modules.Workflow.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Kafka" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/enterprise-request/src/Full.NET.Modules.EnterpriseRequest/Full.NET.Modules.EnterpriseRequest.csproj" />
  </ItemGroup>
</Project>
