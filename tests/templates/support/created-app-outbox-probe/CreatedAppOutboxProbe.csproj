<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 正式应用默认读取分发框架；本仓库可显式指定源码根以聚焦编译同一探针。 -->
    <FullNetFrameworkRoot Condition="'$(FullNetFrameworkRoot)' == ''">../../framework/fullnet</FullNetFrameworkRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FullNetFrameworkRoot)/src/BuildingBlocks/Full.NET.Data.Dapper/Full.NET.Data.Dapper.csproj" />
    <ProjectReference Include="$(FullNetFrameworkRoot)/src/BuildingBlocks/Full.NET.Serialization.MemoryPack/Full.NET.Serialization.MemoryPack.csproj" />
    <ProjectReference Include="$(FullNetFrameworkRoot)/src/Modules/Full.NET.Modules.Identity.Contracts/Full.NET.Modules.Identity.Contracts.csproj" />
  </ItemGroup>
</Project>
