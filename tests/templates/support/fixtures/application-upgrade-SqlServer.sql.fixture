-- 应用增量迁移：给既有商品增加可空描述，保留存量行和原有读写契约。
-- SQL Server 的列 DDL 与扩展属性分别探测，未记账的部分执行可重跑；本次不删除数据。
IF COL_LENGTH(N'dbo.acme_catalog_product', N'Description') IS NULL
    ALTER TABLE dbo.acme_catalog_product ADD Description nvarchar(500) NULL;

IF NOT EXISTS (
    SELECT 1 FROM sys.extended_properties
    WHERE class = 1
      AND major_id = OBJECT_ID(N'dbo.acme_catalog_product')
      AND minor_id = COLUMNPROPERTY(OBJECT_ID(N'dbo.acme_catalog_product'), N'Description', 'ColumnId')
      AND name = N'MS_Description'
)
    EXEC sys.sp_addextendedproperty @name=N'MS_Description', @value=N'商品的可选说明，存量商品保持空值。',
        @level0type=N'SCHEMA', @level0name=N'dbo', @level1type=N'TABLE', @level1name=N'acme_catalog_product',
        @level2type=N'COLUMN', @level2name=N'Description';
