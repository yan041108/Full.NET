{
  "tls_server_config": {
    "cert_file": "/etc/node-exporter/server/tls.crt",
    "key_file": "/etc/node-exporter/server/tls.key",
    "min_version": "TLS12",
    "client_auth_type": "RequireAndVerifyClientCert",
    "client_ca_file": "/etc/node-exporter/client-ca/ca.pem",
    "client_allowed_sans": ["prometheus.observability.svc"]
  }
}
