{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Full.NET Helm values",
  "type": "object",
  "required": [
    "production",
    "roles",
    "databaseConnectionBudget",
    "edgeProtection",
    "database",
    "cache",
    "realtime",
    "dataProtection",
    "api",
    "worker",
    "migrator"
  ],
  "properties": {
    "production": { "type": "boolean" },
    "roles": {
      "type": "object",
      "required": ["api", "worker", "migrator"],
      "properties": {
        "api": { "type": "boolean" },
        "worker": { "type": "boolean" },
        "migrator": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "databaseConnectionBudget": {
      "type": "object",
      "required": [
        "total",
        "apiMaxPoolSize",
        "workerMaxPoolSize",
        "migrationReserve",
        "healthReserve",
        "workerCriticalReserve",
        "apiPermitLimit",
        "apiQueueLimit",
        "apiAcquireTimeoutMilliseconds",
        "workerPermitLimit",
        "workerQueueLimit",
        "workerAcquireTimeoutMilliseconds"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "apiMaxPoolSize": { "type": "integer", "minimum": 1 },
        "workerMaxPoolSize": { "type": "integer", "minimum": 1 },
        "migrationReserve": { "type": "integer", "minimum": 0 },
        "healthReserve": { "type": "integer", "minimum": 0 },
        "workerCriticalReserve": { "type": "integer", "minimum": 0 },
        "apiPermitLimit": { "type": "integer", "minimum": 1 },
        "apiQueueLimit": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "apiAcquireTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "workerPermitLimit": { "type": "integer", "minimum": 1 },
        "workerQueueLimit": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "workerAcquireTimeoutMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 }
      },
      "additionalProperties": false
    },
    "edgeProtection": {
      "type": "object",
      "required": [
        "declared",
        "provider",
        "globalRateLimitPerSecond",
        "globalBurst",
        "globalConcurrentConnections",
        "unavailablePolicy"
      ],
      "properties": {
        "declared": { "type": "boolean" },
        "provider": {
          "type": "string",
          "enum": ["", "CDN", "WAF", "APIGateway", "DistributedRateLimit"]
        },
        "globalRateLimitPerSecond": { "type": "integer", "minimum": 0 },
        "globalBurst": { "type": "integer", "minimum": 0 },
        "globalConcurrentConnections": { "type": "integer", "minimum": 0 },
        "authDimension": { "type": "string" },
        "anonymousDimension": { "type": "string" },
        "unavailablePolicy": {
          "type": "string",
          "enum": ["fail-closed", "fail-open"]
        },
        "secretName": { "type": "string" },
        "serviceName": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 2 },
        "kafkaReplay": {
          "type": "object",
          "required": [
            "enabled",
            "bootstrapSecretName",
            "bootstrapSecretKey",
            "securityProtocol",
            "saslMechanism",
            "saslUsernameSecretName",
            "saslUsernameSecretKey",
            "saslPasswordSecretName",
            "saslPasswordSecretKey",
            "maximumSynchronousMessages",
            "executionTimeoutSeconds"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "bootstrapSecretName": { "type": "string" },
            "bootstrapSecretKey": { "type": "string", "minLength": 1 },
            "securityProtocol": { "type": "string", "enum": ["Ssl", "SaslSsl"] },
            "saslMechanism": {
              "type": "string",
              "enum": ["", "Plain", "ScramSha256", "ScramSha512"]
            },
            "saslUsernameSecretName": { "type": "string" },
            "saslUsernameSecretKey": { "type": "string", "minLength": 1 },
            "saslPasswordSecretName": { "type": "string" },
            "saslPasswordSecretKey": { "type": "string", "minLength": 1 },
            "maximumSynchronousMessages": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "executionTimeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 45 }
          },
          "additionalProperties": false
        },
        "hpa": {
          "type": "object",
          "properties": {
            "minReplicas": { "type": "integer", "minimum": 2 },
            "maxReplicas": { "type": "integer", "minimum": 2 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 2 },
        "maxConcurrency": { "type": "integer", "const": 1 },
        "databaseCapacityBackoffMilliseconds": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "messaging": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["LegacyPolling", "ShadowCdc", "CdcKafka"]
            },
            "kafka": {
              "type": "object",
              "properties": {
                "bootstrapSecretName": { "type": "string" },
                "bootstrapSecretKey": { "type": "string" },
                "consumerGroupProtocol": {
                  "type": "string",
                  "enum": ["Classic", "Consumer"]
                },
                "brokerMajorVersion": { "type": "integer", "minimum": 1 },
                "classicPartitionAssignment": {
                  "type": "string",
                  "enum": ["LegacyRange", "CooperativeSticky"]
                },
                "cooperativeStickyMigrationCompleted": { "type": "boolean" },
                "producerLingerMilliseconds": { "type": "integer", "minimum": 0, "maximum": 1000 },
                "producerBatchSizeBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
                "producerQueueMaxMessages": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "producerQueueMaxKbytes": { "type": "integer", "minimum": 1024, "maximum": 2097152 },
                "producerMaxInFlightRequests": { "type": "integer", "minimum": 1, "maximum": 5 },
                "consumerBufferHighWatermark": { "type": "integer", "minimum": 1, "maximum": 1000000 },
                "consumerBufferLowWatermark": { "type": "integer", "minimum": 0, "maximum": 999999 },
                "partitionBufferHighWatermark": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "partitionBufferLowWatermark": { "type": "integer", "minimum": 0, "maximum": 9999 },
                "partitionKeyConcurrencySlots": { "type": "integer", "minimum": 1, "maximum": 64 },
                "offsetCommitMode": { "type": "string", "enum": ["PerMessage", "PeriodicWatermark"] },
                "offsetCommitIntervalMilliseconds": { "type": "integer", "minimum": 100, "maximum": 60000 },
                "offsetCommitBatchSize": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "periodicOffsetCommitVerified": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "hpa": {
          "type": "object",
          "properties": {
            "minReplicas": { "type": "integer", "minimum": 2 },
            "maxReplicas": { "type": "integer", "minimum": 2 }
          }
        }
      }
    },
    "realtime": {
      "type": "object",
      "properties": {
        "transportMode": {
          "type": "string",
          "enum": ["Default", "WebSocketsOnly"]
        },
        "skipNegotiation": { "type": "boolean" },
        "requireSessionAffinity": { "type": "boolean" }
      }
    }
  }
}
