{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cluster": { "type": "string", "maxLength": 63 },
    "applicationNamespace": { "type": "string", "maxLength": 63 },
    "prometheusClaim": { "type": "string", "maxLength": 63 },
    "alertmanagerClaim": { "type": "string", "maxLength": 63 },
    "rulesSource": { "type": "string" },
    "collectorSource": { "type": "string" },
    "probeAlert": { "type": "boolean" },
    "evaluationInterval": { "type": "string" },
    "externalScrapes": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["job", "targets"],
        "properties": {
          "job": { "enum": ["fullnet-object-capacity", "fluent-bit", "fullnet-edge", "waf", "ddos", "distributed-rate-limit"] },
          "targets": {
            "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
            "items": { "type": "string", "maxLength": 259, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[1-9][0-9]{0,4}$" }
          },
          "scheme": { "enum": ["http", "https"] },
          "metricsPath": { "enum": ["/metrics", "/api/v1/metrics/prometheus"] },
          "caSecretName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" },
          "authorizationSecretName": { "type": "string", "maxLength": 63, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string" },
        "caSecretName": { "type": "string", "maxLength": 63 },
        "authorizationSecretName": { "type": "string", "maxLength": 63 },
        "probeOnly": { "type": "boolean" }
      }
    }
  }
}
