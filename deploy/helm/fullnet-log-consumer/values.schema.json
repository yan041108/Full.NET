{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "experimental", "image", "replicaCount", "environment", "configurationSecretName", "caSecretName", "monitoringNamespace", "podMonitor", "resources"],
  "properties": {
    "batchMaxRecords": {"type": "integer", "minimum": 1, "maximum": 8},
    "enabled": {"type": "boolean"},
    "experimental": {"type": "boolean"},
    "environment": {"enum": ["Production", "Staging", "Development"]},
    "configurationSecretName": {"type": "string", "maxLength": 253},
    "caSecretName": {"type": "string", "maxLength": 253},
    "monitoringNamespace": {"type": "string", "minLength": 1, "maxLength": 63},
    "podMonitor": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "labels"],
      "properties": {"enabled": {"type": "boolean"}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}}
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 8},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourceBudget"},
        "limits": {"$ref": "#/definitions/resourceBudget"}
      }
    }
  },
  "definitions": {
    "resourceBudget": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "string", "minLength": 1}, "memory": {"type": "string", "minLength": 1}}
    }
  }
}
