{
  "name": "fullnet-sqlserver-outbox-shadow",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "tasks.max": "1",
    "database.hostname": "${FULLNET_SQLSERVER_HOST}",
    "database.port": "${FULLNET_SQLSERVER_PORT}",
    "database.user": "${FULLNET_SQLSERVER_USER}",
    "database.password": "${FULLNET_SQLSERVER_PASSWORD}",
    "database.names": "${FULLNET_SQLSERVER_DATABASE}",
    "database.encrypt": "false",
    "topic.prefix": "fullnet.dev.shadow.sqlserver",
    "table.include.list": "dbo.fn_messaging_outbox_event",
    "capture.instance": "fullnet_fn_messaging_outbox_event",
    "snapshot.mode": "no_data",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "key.converter.schemas.enable": "false",
    "schema.history.internal.kafka.topic": "fullnet.dev.shadow.internal.schema-history.sqlserver",
    "schema.history.internal.kafka.bootstrap.servers": "${FULLNET_KAFKA_BOOTSTRAP_SERVERS}",
    "schema.history.internal.kafka.topic.replication.factor": "1",
    "heartbeat.topics.prefix": "fullnet.dev.shadow.internal.heartbeat.sqlserver",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "Id",
    "transforms.outbox.table.field.event.key": "PartitionKey",
    "transforms.outbox.table.field.event.type": "MessageType",
    "transforms.outbox.table.field.event.payload": "Payload",
    "transforms.outbox.route.by.field": "MessageType",
    "transforms.outbox.route.topic.replacement": "fullnet.dev.shadow.${routedByValue}",
    "transforms.outbox.table.op.valid.values": "c",
    "transforms.outbox.table.fields.additional.placement": "Id:header:event_id,MessageType:header:message_type,SchemaVersion:header:schema_version,ContentType:header:content_type,TenantId:header:tenant_id,CorrelationId:header:correlation_id,CausationId:header:causation_id,TraceParent:header:trace_parent,Producer:header:producer,OccurredAtUtc:header:occurred_at_utc"
  }
}