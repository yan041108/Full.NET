{
  "locale": "zh-Hans",
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/identity/login",
      "style": {
        "navigationBarTitleText": "%identity.login.title%"
      }
    },
    {
      "path": "pages/settings/locale",
      "style": {
        "navigationBarTitleText": "%settings.title%"
      }
    },
    {
      "path": "pages/ui/component-smoke",
      "style": {
        "navigationBarTitleText": "%ui.smoke.title%"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/workflow",
      "pages": [
        {
          "path": "todos",
          "style": {
            "navigationBarTitleText": "%workflow.todos.title%"
          }
        },
        {
          "path": "todo-detail",
          "style": {
            "navigationBarTitleText": "%workflow.todo.title%"
          }
        }
      ]
    },
    {
      "root": "pages/notifications",
      "pages": [
        {
          "path": "inbox",
          "style": {
            "navigationBarTitleText": "%notifications.inbox.title%"
          }
        },
        {
          "path": "inbox-detail",
          "style": {
            "navigationBarTitleText": "%notifications.inbox.detailTitle%"
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "%settings.title%",
    "navigationBarBackgroundColor": "#0B1C2D",
    "backgroundColor": "#071421"
  }
}
