<Project>
  <!--
    FullNetAotAnalysis / FullNetPublishMode=NativeAot 共享同一套 AOT 编译条件；
    分析器与 Configuration Binding Generator 覆盖 Host.Api net10.0 完整引用闭包，
    仅排除 netstandard2.0 源码生成器。路径判断一律归一化为 '/'，避免 Linux 条件失效。
  -->
  <PropertyGroup>
    <_FullNetProjectDirNormalized>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))</_FullNetProjectDirNormalized>
    <FullNetIsNetStandard20Generator>false</FullNetIsNetStandard20Generator>
    <FullNetIsNetStandard20Generator Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">true</FullNetIsNetStandard20Generator>
    <FullNetIsAotCompile>false</FullNetIsAotCompile>
    <FullNetIsAotCompile Condition="'$(FullNetAotAnalysis)' == 'true' or '$(FullNetPublishMode)' == 'NativeAot' or '$(PublishAot)' == 'true'">true</FullNetIsAotCompile>
    <FullNetIsNetCoreAppAotEligible>false</FullNetIsNetCoreAppAotEligible>
    <FullNetIsNetCoreAppAotEligible Condition="'$(FullNetIsNetStandard20Generator)' != 'true' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp' and $([MSBuild]::VersionGreaterThanOrEquals($([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')), 8.0))">true</FullNetIsNetCoreAppAotEligible>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FullNetIsAotCompile)' == 'true' and '$(FullNetIsNetCoreAppAotEligible)' == 'true'">
    <DefineConstants>$(DefineConstants);FULLNET_AOT_COMPILE</DefineConstants>
    <InterceptorsPreviewNamespaces>$(InterceptorsPreviewNamespaces);Dapper.AOT</InterceptorsPreviewNamespaces>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Dapper.AOT</InterceptorsNamespaces>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
</Project>
