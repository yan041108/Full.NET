# 复制为 .env.local 后按需调整。Vite 仅注入 VITE_ 前缀变量。

# 本地 API 根地址；省略时 dev 通过 vite proxy 访问 /api 与 /hubs。
# VITE_API_BASE_URL=http://localhost:5149

# 身份认证模式：省略或 legacy=用户名密码登录；oidc-center=身份中心 SSO（T08）。
# VITE_IDENTITY_AUTH_MODE=legacy

# OIDC 公开客户端 ID，仅 oidc-center 模式使用；默认 admin-spa。
# VITE_IDENTITY_OIDC_CLIENT_ID=admin-spa

# 实时通知 Hub；E2E 或纯 Mock 环境可设为 false。
# VITE_REALTIME_ENABLED=true

# 开发服务器严格 CSP；真实栈 E2E 使用 VITE_STRICT_CSP=1。
# VITE_STRICT_CSP=0